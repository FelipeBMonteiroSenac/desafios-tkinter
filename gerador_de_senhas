
import tkinter as tk
from tkinter import messagebox
import secrets
import string


def gerar_senha():
    try:
        tamanho = int(entrada_tamanho.get())

        if tamanho < 4 or tamanho > 128:
            messagebox.showwarning(
                "Aviso",
                "O tamanho deve estar entre 4 e 128 caracteres."
            )
            return

        caracteres = string.ascii_lowercase

        if var_maiusculas.get():
            caracteres += string.ascii_uppercase

        if var_numeros.get():
            caracteres += string.digits

        if var_simbolos.get():
            caracteres += "!@#$%&*()-_=+?"

        if not any([
            var_maiusculas.get(),
            var_numeros.get(),
            var_simbolos.get()
        ]):
            # Pelo menos letras minúsculas serão utilizadas.
            pass

        senha = ''.join(
            secrets.choice(caracteres)
            for _ in range(tamanho)
        )

        campo_senha.config(state="normal")
        campo_senha.delete(0, tk.END)
        campo_senha.insert(0, senha)
        campo_senha.config(state="readonly")

    except ValueError:
        messagebox.showerror(
            "Erro",
            "Digite um tamanho válido para a senha."
        )


def copiar_senha():
    senha = campo_senha.get()

    if not senha:
        messagebox.showwarning(
            "Aviso",
            "Gere uma senha primeiro."
        )
        return

    janela.clipboard_clear()
    janela.clipboard_append(senha)
    janela.update()

    messagebox.showinfo(
        "Sucesso",
        "Senha copiada para a área de transferência!"
    )


# Janela principal
janela = tk.Tk()
janela.title("Gerador de Senhas")
janela.geometry("400x420")
janela.resizable(False, False)
janela.configure(bg="#20232A")

# Título
titulo = tk.Label(
    janela,
    text="Gerador de Senhas",
    font=("Arial", 20, "bold"),
    bg="#20232A",
    fg="#61DAFB"
)
titulo.pack(pady=20)

# Tamanho da senha
tk.Label(
    janela,
    text="Tamanho da senha:",
    font=("Arial", 11),
    bg="#20232A",
    fg="white"
).pack()

entrada_tamanho = tk.Entry(
    janela,
    font=("Arial", 12),
    justify="center",
    width=10
)
entrada_tamanho.insert(0, "16")
entrada_tamanho.pack(pady=8)

# Opções
var_maiusculas = tk.BooleanVar(value=True)
var_numeros = tk.BooleanVar(value=True)
var_simbolos = tk.BooleanVar(value=True)

opcoes = [
    ("Incluir letras maiúsculas", var_maiusculas),
    ("Incluir números", var_numeros),
    ("Incluir símbolos", var_simbolos)
]

for texto, variavel in opcoes:
    tk.Checkbutton(
        janela,
        text=texto,
        variable=variavel,
        font=("Arial", 10),
        bg="#20232A",
        fg="white",
        selectcolor="#343942",
        activebackground="#20232A",
        activeforeground="white"
    ).pack(anchor="w", padx=95, pady=3)

# Campo da senha
campo_senha = tk.Entry(
    janela,
    font=("Consolas", 12),
    justify="center",
    width=30,
    state="readonly",
    readonlybackground="#343942",
    fg="#61DAFB"
)
campo_senha.pack(pady=18)

# Botões
tk.Button(
    janela,
    text="Gerar senha",
    command=gerar_senha,
    font=("Arial", 11, "bold"),
    bg="#61DAFB",
    fg="#20232A",
    width=20,
    relief="flat"
).pack(pady=5)

